{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/prototype/index.html" },
    { "source": "/admin", "destination": "/prototype/admin.html" },
    { "source": "/api/(.*)", "destination": "/prototype/index.html" },
    { "source": "/(.*)", "destination": "/prototype/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
